# Copy to .env and fill in real values (.env is gitignored).

# ---------------------------------------------------------------------------
# Firebase web app config  (Console > Project settings > Your apps > Web)
# These are public identifiers, not secrets - they are sent to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# ---------------------------------------------------------------------------
# Firebase Admin credentials - SECRET. Verifies sessions and sets roles.
# Console > Project settings > Service accounts > Generate new private key.
#
# Local dev: just save the downloaded file as ./firebase-service-account.json
# Hosting (Vercel): paste the JSON (or its base64) into the variable below.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Required on the /admin/signup page. Change it to revoke outstanding invites.
SIGNUP_INVITE_CODE="change-me"

# These emails become admin automatically on first Google sign-in, so the
# first real admin can get in. Comma-separated.
FIREBASE_BOOTSTRAP_ADMIN_EMAILS="owner@example.com"

# Set to "false" once Google sign-in works, to retire the password login.
ALLOW_LEGACY_ADMIN_LOGIN="true"

# ---------------------------------------------------------------------------
# Legacy password login (retired once ALLOW_LEGACY_ADMIN_LOGIN=false)
# ---------------------------------------------------------------------------
# Signs the legacy admin cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Used by `npm run seed` / `npm run admin:set`.
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="owner@example.com"
# ADMIN_PASSWORD="a-long-password"
