# Copy to .env and fill in real values (.env is gitignored).

# ---------------------------------------------------------------------------
# Firebase web app config  (Console > Project settings > Your apps > Web)
# These are public identifiers, not secrets - they are sent to the browser.
# Pull them automatically with:  firebase apps:sdkconfig WEB
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# ---------------------------------------------------------------------------
# Firebase Admin credentials - SECRET. Verifies sessions and sets roles.
# Console > Project settings > Service accounts > Generate new private key.
#
# Paste the JSON as a single line, or base64-encode it (recommended, since the
# raw JSON contains quotes and \n escapes that break .env parsing):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
#
# Alternatively, save the file as ./firebase-service-account.json (gitignored).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Required on /admin/signup. Change it to revoke outstanding invites.
SIGNUP_INVITE_CODE="change-me"

# These emails become admin automatically on first Google sign-in, so the
# first admin can get in. Comma-separated.
FIREBASE_BOOTSTRAP_ADMIN_EMAILS="owner@example.com"
