# Copy to .env and fill in with values from your own Supabase project.
# Project Settings -> API. Never commit the real .env.

# Public: safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret: server only. Bypasses Row Level Security - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Code new staff must enter to sign up. Leave empty to let anyone create a
# pending account (an admin still has to approve them).
SIGNUP_INVITE_CODE=change-this

# Comma-separated Google accounts that become admin on first sign-in
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# The origin the app is served from. Use the live URL in production, and add
# "<origin>/auth/callback" to Supabase -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
